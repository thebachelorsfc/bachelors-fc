# Copy to .env.local — get these from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, never expose in browser. Used by Admin actions.
SUPABASE_SERVICE_ROLE_KEY=
# Keep the SAME url while on netlify.app so canonical/OG/verification stay valid
NEXT_PUBLIC_SITE_URL=https://thebachelorsfc.netlify.app
# Admin password for /admin — MUST change before deploying publicly (dev default is documented in README-PHASE1.md)
ADMIN_PASSWORD=
